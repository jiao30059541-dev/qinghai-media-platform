// app/media/page.tsx - 重构版本：专业资源列表页
import Link from 'next/link'
import { Filter, Search, MapPin, Tag, DollarSign, Star, Eye, Calendar, Sliders, Grid, List, ChevronDown, X } from 'lucide-react'
import MediaCard from '@/components/MediaCard'
import { getMediaList, getCities, getCategories } from '@/lib/db'
import { Button } from '@/components/ui/Button'
import { Input } from '@/components/ui/Input'
import { Select } from '@/components/ui/Select'
import { cn } from '@/lib/utils'

interface SearchParams {
  city?: string
  category?: string
  minPrice?: string
  maxPrice?: string
  sort?: string
  page?: string
  search?: string
  exposure?: string
  rating?: string
}

export default async function MediaPage({
  searchParams,
}: {
  searchParams: Promise<SearchParams>
}) {
  const params = await searchParams
  const city = params.city
  const category = params.category
  const minPrice = params.minPrice ? parseInt(params.minPrice) : undefined
  const maxPrice = params.maxPrice ? parseInt(params.maxPrice) : undefined
  const sort = params.sort || 'newest'
  const page = parseInt(params.page || '1')
  const search = params.search
  const exposure = params.exposure
  const rating = params.rating
  
  // 获取数据
  const mediaList = await getMediaList({ 
    city, 
    category, 
    minPrice, 
    maxPrice,
    search,
    exposure,
    rating
  }) as any[]
  
  const cities = await getCities() as any[]
  const categories = await getCategories() as any[]
  
  // 排序逻辑
  let sortedMedia = [...mediaList]
  if (sort === 'price_low') {
    sortedMedia.sort((a, b) => (a.deal_price || 0) - (b.deal_price || 0))
  } else if (sort === 'price_high') {
    sortedMedia.sort((a, b) => (b.deal_price || 0) - (a.deal_price || 0))
  } else if (sort === 'exposure_high') {
    sortedMedia.sort((a, b) => (b.daily_exposure || 0) - (a.daily_exposure || 0))
  } else if (sort === 'rating_high') {
    sortedMedia.sort((a, b) => (b.rating || 0) - (a.rating || 0))
  }
  
  // 分页
  const itemsPerPage = 12
  const totalPages = Math.ceil(sortedMedia.length / itemsPerPage)
  const startIndex = (page - 1) * itemsPerPage
  const endIndex = startIndex + itemsPerPage
  const paginatedMedia = sortedMedia.slice(startIndex, endIndex)
  
  // 构建查询参数
  const buildQueryString = (updates: Partial<SearchParams>) => {
    const newParams = new URLSearchParams()
    if (city) newParams.set('city', city)
    if (category) newParams.set('category', category)
    if (minPrice) newParams.set('minPrice', minPrice.toString())
    if (maxPrice) newParams.set('maxPrice', maxPrice.toString())
    if (sort) newParams.set('sort', sort)
    if (search) newParams.set('search', search)
    if (exposure) newParams.set('exposure', exposure)
    if (rating) newParams.set('rating', rating)
    
    Object.entries(updates).forEach(([key, value]) => {
      if (value !== undefined && value !== '') {
        newParams.set(key, value.toString())
      } else {
        newParams.delete(key)
      }
    })
    
    return newParams.toString()
  }

  // 价格范围选项
  const priceRanges = [
    { label: '全部价格', min: undefined, max: undefined },
    { label: '5,000元以下', min: undefined, max: 5000 },
    { label: '5,000 - 20,000元', min: 5000, max: 20000 },
    { label: '20,000 - 50,000元', min: 20000, max: 50000 },
    { label: '50,000元以上', min: 50000, max: undefined }
  ]

  // 曝光量选项
  const exposureOptions = [
    { value: '', label: '全部曝光量' },
    { value: 'high', label: '高曝光 (10万+/日)' },
    { value: 'medium', label: '中曝光 (5-10万/日)' },
    { value: 'low', label: '低曝光 (5万以下/日)' }
  ]

  // 评分选项
  const ratingOptions = [
    { value: '', label: '全部评分' },
    { value: '4.5', label: '4.5星以上' },
    { value: '4.0', label: '4.0星以上' },
    { value: '3.5', label: '3.5星以上' }
  ]

  // 排序选项
  const sortOptions = [
    { value: 'newest', label: '最新上架' },
    { value: 'price_low', label: '价格从低到高' },
    { value: 'price_high', label: '价格从高到低' },
    { value: 'exposure_high', label: '曝光量最高' },
    { value: 'rating_high', label: '评分最高' }
  ]

  // 当前筛选标签
  const activeFilters = []
  if (city) activeFilters.push({ label: `城市: ${city}`, key: 'city' })
  if (category) activeFilters.push({ label: `类型: ${category}`, key: 'category' })
  if (minPrice !== undefined || maxPrice !== undefined) {
    const range = priceRanges.find(r => r.min === minPrice && r.max === maxPrice)
    if (range) activeFilters.push({ label: `价格: ${range.label}`, key: 'price' })
  }
  if (exposure) {
    const exp = exposureOptions.find(e => e.value === exposure)
    if (exp) activeFilters.push({ label: `曝光: ${exp.label}`, key: 'exposure' })
  }
  if (rating) {
    const rat = ratingOptions.find(r => r.value === rating)
    if (rat) activeFilters.push({ label: `评分: ${rat.label}`, key: 'rating' })
  }

  return (
    <div className="min-h-screen bg-gradient-to-b from-gray-50 to-white">
      {/* 顶部横幅 */}
      <div className="bg-gradient-to-r from-primary via-primary/90 to-blue-600 text-white">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
          <div className="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8">
            <div className="flex-1">
              <h1 className="text-4xl md:text-5xl font-bold mb-4">
                广告资源库
              </h1>
              <p className="text-xl opacity-90 max-w-3xl">
                像找房子一样找广告位，精准筛选全省优质广告资源
              </p>
            </div>
            <div className="bg-white/10 backdrop-blur-sm rounded-2xl p-6 lg:w-96">
              <h3 className="text-lg font-semibold mb-4">资源统计</h3>
              <div className="grid grid-cols-2 gap-4">
                <div className="text-center">
                  <div className="text-3xl font-bold">{mediaList.length}</div>
                  <div className="text-sm opacity-80">可用资源</div>
                </div>
                <div className="text-center">
                  <div className="text-3xl font-bold">{cities.length}</div>
                  <div className="text-sm opacity-80">覆盖城市</div>
                </div>
                <div className="text-center">
                  <div className="text-3xl font-bold">{categories.length}</div>
                  <div className="text-sm opacity-80">广告类型</div>
                </div>
                <div className="text-center">
                  <div className="text-3xl font-bold">24h</div>
                  <div className="text-sm opacity-80">极速响应</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 -mt-8">
        {/* 主内容区域 */}
        <div className="grid grid-cols-1 lg:grid-cols-4 gap-8">
          {/* 左侧筛选栏 - 固定位置 */}
          <div className="lg:col-span-1">
            <div className="bg-white rounded-3xl shadow-xl p-6 sticky top-6 border border-gray-200">
              <div className="flex items-center justify-between mb-8">
                <h2 className="text-xl font-bold text-gray-900 flex items-center">
                  <Sliders className="w-5 h-5 mr-2" />
                  高级筛选
                </h2>
                <Link 
                  href="/media" 
                  className="text-sm text-primary hover:text-blue-700 font-medium"
                >
                  重置全部
                </Link>
              </div>

              {/* 搜索框 */}
              <div className="mb-8">
                <h3 className="font-semibold text-gray-700 mb-4">搜索广告位</h3>
                <form action="/media" method="GET" className="relative">
                  <input type="hidden" name="page" value="1" />
                  {city && <input type="hidden" name="city" value={city} />}
                  {category && <input type="hidden" name="category" value={category} />}
                  {minPrice && <input type="hidden" name="minPrice" value={minPrice} />}
                  {maxPrice && <input type="hidden" name="maxPrice" value={maxPrice} />}
                  <input
                    type="text"
                    name="search"
                    defaultValue={search}
                    placeholder="输入广告位名称或关键词..."
                    className="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
                  />
                  <Search className="w-5 h-5 text-gray-400 absolute left-3 top-1/2 transform -translate-y-1/2" />
                </form>
              </div>

              {/* 城市筛选 */}
              <div className="mb-8">
                <h3 className="font-semibold text-gray-700 mb-4 flex items-center">
                  <MapPin className="w-4 h-4 mr-2" />
                  选择城市
                </h3>
                <div className="space-y-2">
                  <Link
                    href={`/media?${buildQueryString({ city: undefined, page: '1' })}`}
                    className={cn(
                      "block px-4 py-3 rounded-xl text-sm transition-all",
                      !city 
                        ? "bg-primary text-white font-medium shadow-sm" 
                        : "text-gray-600 hover:bg-gray-50 border border-gray-200"
                    )}
                  >
                    全部城市 ({mediaList.length})
                  </Link>
                  {cities.slice(0, 8).map((c: any) => (
                    <Link
                      key={c.city}
                      href={`/media?${buildQueryString({ city: c.city, page: '1' })}`}
                      className={cn(
                        "block px-4 py-3 rounded-xl text-sm transition-all",
                        city === c.city
                          ? "bg-primary/10 text-primary font-medium border border-primary/20"
                          : "text-gray-600 hover:bg-gray-50 border border-gray-200"
                      )}
                    >
                      {c.city}
                      <span className="float-right text-xs text-gray-500">
                        {c.count || 0}
                      </span>
                    </Link>
                  ))}
                  {cities.length > 8 && (
                    <div className="pt-2">
                      <Link
                        href={`/media?${buildQueryString({ city: undefined, page: '1' })}`}
                        className="text-sm text-primary hover:text-blue-700 font-medium flex items-center"
                      >
                        查看更多城市 <ChevronDown className="w-4 h-4 ml-1" />
                      </Link>
                    </div>
                  )}
                </div>
              </div>

              {/* 广告类型筛选 */}
              <div className="mb-8">
                <h3 className="font-semibold text-gray-700 mb-4 flex items-center">
                  <Tag className="w-4 h-4 mr-2" />
                  广告类型
                </h3>
                <div className="space-y-2">
                  <Link
                    href={`/media?${buildQueryString({ category: undefined, page: '1' })}`}
                    className={cn(
                      "block px-4 py-3 rounded-xl text-sm transition-all",
                      !category
                        ? "bg-primary text-white font-medium shadow-sm"
                        : "text-gray-600 hover:bg-gray-50 border border-gray-200"
                    )}
                  >
                    全部类型 ({mediaList.length})
                  </Link>
                  {categories.slice(0, 6).map((c: any) => (
                    <Link
                      key={c.name}
                      href={`/media?${buildQueryString({ category: c.name, page: '1' })}`}
                      className={cn(
                        "block px-4 py-3 rounded-xl text-sm transition-all",
                        category === c.name
                          ? "bg-primary/10 text-primary font-medium border border-primary/20"
                          : "text-gray-600 hover:bg-gray-50 border border-gray-200"
                      )}
                    >
                      {c.name}
                      <span className="float-right text-xs text-gray-500">
                        {c.count || 0}
                      </span>
                    </Link>
                  ))}
                </div>
              </div>

              {/* 价格筛选 */}
              <div className="mb-8">
                <h3 className="font-semibold text-gray-700 mb-4 flex items-center">
                  <DollarSign className="w-4 h-4 mr-2" />
                  价格范围
                </h3>
                <div className="space-y-2">
                  {priceRanges.map((range, index) => (
                    <Link
                      key={index}
                      href={`/media?${buildQueryString({ 
                        minPrice: range.min?.toString(), 
                        maxPrice: range.max?.toString(),
                        page: '1'
                      })}`}
                      className={cn(
                        "block px-4 py-3 rounded-xl text-sm transition-all",
                        minPrice === range.min && maxPrice === range.max
                          ? "bg-primary/10 text-primary font-medium border border-primary/20"
                          : "text-gray-600 hover:bg-gray-50 border border-gray-200"
                      )}
                    >
                      {range.label}
                    </Link>
                  ))}
                </div>
              </div>

              {/* 曝光量筛选 */}
              <div className="mb-8">
                <h3 className="font-semibold text-gray-700 mb-4 flex items-center">
                  <Eye className="w-4 h-4 mr-2" />
                  曝光量
                </h3>
                <div className="space-y-2">
                  {exposureOptions.map((option) => (
                    <Link
                      key={option.value}
                      href={`/media?${buildQueryString({ exposure: option.value, page: '1' })}`}
                      className={cn(
                        "block px-4 py-3 rounded-xl text-sm transition-all",
                        exposure === option.value
                          ? "bg-primary/10 text-primary font-medium border border-primary/20"
                          : "text-gray-600 hover:bg-gray-50 border border-gray-200"
                      )}
                    >
                      {option.label}
                    </Link>
                  ))}
                </div>
              </div>

              {/* 评分筛选 */}
              <div className="mb-8">
                <h3 className="font-semibold text-gray-700 mb-4 flex items-center">
                  <Star className="w-4 h-4 mr-2" />
                  评分
                </h3>
                <div className="space-y-2">
                  {ratingOptions.map((option) => (
                    <Link
                      key={option.value}
                      href={`/media?${buildQueryString({ rating: option.value, page: '1' })}`}
                      className={cn(
                        "block px-4 py-3 rounded-xl text-sm transition-all",
                        rating === option.value
                          ? "bg-primary/10 text-primary font-medium border border-primary/20"
                          : "text-gray-600 hover:bg-gray-50 border border-gray-200"
                      )}
                    >
                      {option.label}
                    </Link>
                  ))}
                </div>
              </div>

              {/* 应用筛选按钮 */}
              <div className="pt-4 border-t border-gray-200">
                <div className="text-center text-sm text-gray-500 mb-4">
                  当前筛选出 <span className="font-bold text-primary">{mediaList.length}</span> 个资源
                </div>
                <Link
                  href={`/media?${buildQueryString({ page: '1' })}`}
                  className="block w-full text-center px-4 py-3 bg-primary text-white font-semibold rounded-xl hover:bg-primary/90 transition-colors"
                >
                  应用筛选条件
                </Link>
              </div>
            </div>
          </div>

          {/* 右侧内容区域 */}
          <div className="lg:col-span-3">
            {/* 工具栏 */}
            <div className="bg-white rounded-3xl shadow-xl p-6 mb-8 border border-gray-200">
              <div className="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-6">
                <div className="flex-1">
                  <div className="flex items-center gap-4 mb-4">
                    <h2 className="text-2xl font-bold text-gray-900">
                      广告资源列表
                    </h2>
                    <span className="px-3 py-1 bg-primary/10 text-primary text-sm font-medium rounded-full">
                      {mediaList.length} 个资源
                    </span>
                  </div>
                  
                  {/* 当前筛选标签 */}
                  {activeFilters.length > 0 && (
                    <div className="flex flex-wrap gap-2 mb-4">
                      {activeFilters.map((filter, index) => (
                        <div
                          key={index}
                          className="inline-flex items-center gap-2 px-3 py-1.5 bg-gray-100 text-gray-700 text-sm rounded-lg"
                        >
                          {filter.label}
                          <Link
                            href={`/media?${buildQueryString({ [filter.key]: undefined, page: '1' })}`}
                            className="text-gray-500 hover:text-gray-700"
                          >
                            <X className="w-3 h-3" />
                          </Link>
                        </div>
                      ))}
                      <Link
                        href="/media"
                        className="text-sm text-primary hover:text-blue-700 font-medium"
                      >
                        清除全部
                      </Link>
                    </div>
                  )}
                </div>

                <div className="flex flex-col sm:flex-row items-start sm:items-center gap-4 w-full lg:w-auto">
                  {/* 排序选项 */}
                  <div className="flex items-center gap-3">
                    <span className="text-gray-600 whitespace-nowrap">排序:</span>
                    <div className="flex bg-gray-100 rounded-xl p-1">
                      {sortOptions.map((option) => (
                        <Link
                          key={option.value}
                          href={`/media?${buildQueryString({ sort: option.value, page: '1' })}`}
                          className={cn(
                            "px-4 py-2 text-sm rounded-lg transition-all whitespace-nowrap",
                            sort === option.value
                              ? "bg-white text-primary font-medium shadow-sm"
                              : "text-gray-600 hover:text-gray-900"
                          )}
                        >
                          {option.label}
                        </Link>
                      ))}
                    </div>
                  </div>

                  {/* 视图切换 */}
                  <div className="flex items-center gap-2">
                    <button className="p-2 rounded-lg bg-gray-100 text-gray-600 hover:bg-gray-200">
                      <Grid className="w-5 h-5" />
                    </button>
                    <button className="p-2 rounded-lg text-gray-400 hover:bg-gray-100">
                      <List className="w-5 h-5" />
                    </button>
                  </div>
                </div>
              </div>
            </div>

            {/* 广告位网格 */}
            {paginatedMedia.length > 0 ? (
              <>
                <div className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
                  {paginatedMedia.map((media: any, index: number) => (
                    <MediaCard 
                      key={media.id} 
                      media={{
                        id: media.id,
                        name: media.name,
                        city: media.city,
                        category: media.category,
                        exposure: media.daily_exposure ? `日均${media.daily_exposure.toLocaleString()}曝光` : '曝光量待评估',
                        listPrice: media.list_price || 0,
                        dealPrice: media.deal_price || 0,
                        image: media.image_url || '/media/default.jpg',
                        isFeatured: media.is_featured,
                        rating: media.rating || 4.5,
                        views: media.view_count || 0
                      }}
                      index={index}
                    />
                  ))}
                </div>

                {/* 分页 */}
                {totalPages > 1 && (
                  <div className="mt-12 flex justify-center">
                    <nav className="flex items-center gap-2">
                      {page > 1 && (
                        <Link
                          href={`/media?${buildQueryString({ page: (page - 1).toString() })}`}
                          className="px-5 py-2.5 border border-gray-300 rounded-xl text-gray-700 hover:bg-gray-50 flex items-center gap-2"
                        >
                          <ChevronDown className="w-4 h-4 rotate-90" />
                          上一页
                        </Link>
                      )}

                      {Array.from({ length: Math.min(5, totalPages) }, (_, i) => {
                        let pageNum
                        if (totalPages <= 5) {
                          pageNum = i + 1
                        } else if (page <= 3) {
                          pageNum = i + 1
                        } else if (page >= totalPages - 2) {
                          pageNum = totalPages - 4 + i
                        } else {
                          pageNum = page - 2 + i
                        }

                        return (
                          <Link
                            key={pageNum}
                            href={`/media?${buildQueryString({ page: pageNum.toString() })}`}
                            className={cn(
                              "px-5 py-2.5 rounded-xl text-sm font-medium",
                              page === pageNum
                                ? "bg-primary text-white"
                                : "border border-gray-300 text-gray-700 hover:bg-gray-50"
                            )}
                          >
                            {pageNum}
                          </Link>
                        )
                      })}

                      {page < totalPages && (
                        <Link
                          href={`/media?${buildQueryString({ page: (page + 1).toString() })}`}
                          className="px-5 py-2.5 border border-gray-300 rounded-xl text-gray-700 hover:bg-gray-50 flex items-center gap-2"
                        >
                          下一页
                          <ChevronDown className="w-4 h-4 -rotate-90" />
                        </Link>
                      )}
                    </nav>
                  </div>
                )}
              </>
            ) : (
              <div className="bg-white rounded-3xl shadow-xl p-16 text-center border border-gray-200">
                <div className="w-24 h-24 mx-auto mb-6 bg-gray-100 rounded-2xl flex items-center justify-center">
                  <Search className="w-12 h-12 text-gray-400" />
                </div>
                <h3 className="text-2xl font-bold text-gray-900 mb-3">
                  未找到匹配的广告位
                </h3>
                <p className="text-gray-600 mb-8 max-w-md mx-auto">
                  当前筛选条件下没有找到合适的广告资源，请尝试调整筛选条件或选择其他城市。
                </p>
                <div className="flex flex-col sm:flex-row gap-4 justify-center">
                  <Link
                    href="/media"
                    className="px-6 py-3 bg-primary text-white rounded-xl hover:bg-primary/90 transition-colors font-medium"
                  >
                    重置筛选条件
                  </Link>
                  <Link
                    href="/ai-chat"
                    className="px-6 py-3 border border-gray-300 text-gray-700 rounded-xl hover:bg-gray-50 transition-colors font-medium"
                  >
                    咨询AI助手
                  </Link>
                </div>
              </div>
            )}

            {/* 底部提示 */}
            <div className="mt-12 bg-gradient-to-r from-primary/5 to-blue-50 border border-primary/20 rounded-3xl p-8">
              <h4 className="font-bold text-primary mb-4 text-lg flex items-center">
                <Star className="w-5 h-5 mr-2" />
                使用建议
              </h4>
              <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div className="space-y-3">
                  <div className="flex items-start">
                    <div className="w-2 h-2 bg-primary rounded-full mt-2 mr-3"></div>
                    <span className="text-gray-700">点击广告位卡片可查看详细信息和更多图片</span>
                  </div>
                  <div className="flex items-start">
                    <div className="w-2 h-2 bg-primary rounded-full mt-2 mr-3"></div>
                    <span className="text-gray-700">在详情页点击"加入投放方案"可将广告位添加到投放篮</span>
                  </div>
                </div>
                <div className="space-y-3">
                  <div className="flex items-start">
                    <div className="w-2 h-2 bg-primary rounded-full mt-2 mr-3"></div>
                    <span className="text-gray-700">支持多选，创建完整的广告投放组合</span>
                  </div>
                  <div className="flex items-start">
                    <div className="w-2 h-2 bg-primary rounded-full mt-2 mr-3"></div>
                    <span className="text-gray-700">完成后可在投放方案页面生成AI投放策略</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  )
}