// components/MediaCard.tsx - 新版大图资产卡
'use client'

import { motion } from 'framer-motion'
import { MapPin, Eye, Star, Plus } from 'lucide-react'
import { Button } from '@/components/ui/Button'
import { cn } from '@/lib/utils'

interface MediaCardProps {
  media: {
    id: number
    name: string
    city: string
    category: string
    exposure: string
    listPrice: number
    dealPrice: number
    image: string
    isFeatured?: boolean
    rating?: number
    views?: number
  }
  index: number
}

export default function MediaCard({ media, index }: MediaCardProps) {
  const discount = Math.round((1 - media.dealPrice / media.listPrice) * 100)
  
  return (
    <motion.div
      initial={{ opacity: 0, y: 20 }}
      whileInView={{ opacity: 1, y: 0 }}
      transition={{ duration: 0.5, delay: index * 0.05 }}
      viewport={{ once: true }}
      whileHover={{ y: -8 }}
      className="group relative overflow-hidden rounded-3xl shadow-xl hover:shadow-2xl transition-all duration-300 bg-white"
    >
      {/* 主视觉图占70% */}
      <div className="relative h-64 overflow-hidden">
        <div 
          className="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-110"
          style={{ backgroundImage: `url(${media.image})` }}
        />
        
        {/* 渐变遮罩 */}
        <div className="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent" />
        
        {/* 特色标签 */}
        {media.isFeatured && (
          <div className="absolute top-4 left-4 bg-secondary text-white px-3 py-1 rounded-full text-sm font-semibold">
            精选推荐
          </div>
        )}
        
        {/* 折扣标签 */}
        {discount > 0 && (
          <div className="absolute top-4 right-4 bg-red-500 text-white px-3 py-1 rounded-full text-sm font-semibold">
            -{discount}%
          </div>
        )}
        
        {/* 悬停操作 */}
        <div className="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
          <Button variant="primary" className="transform translate-y-4 group-hover:translate-y-0 transition-transform">
            <Plus className="w-4 h-4 mr-2" />
            加入方案
          </Button>
        </div>
      </div>
      
      {/* 内容区域 */}
      <div className="p-6">
        <div className="flex items-start justify-between mb-3">
          <div>
            <h3 className="text-lg font-bold text-gray-900 line-clamp-1 mb-1">
              {media.name}
            </h3>
            <div className="flex items-center text-gray-600 text-sm">
              <MapPin className="w-4 h-4 mr-1" />
              {media.city}
              <span className="mx-2">•</span>
              {media.category}
            </div>
          </div>
          
          <div className="flex items-center text-amber-500">
            <Star className="w-4 h-4 fill-current" />
            <span className="ml-1 text-sm">{media.rating || 4.8}</span>
          </div>
        </div>
        
        {/* 标签 */}
        <div className="flex flex-wrap gap-2 mb-4">
          <span className="px-2 py-1 bg-blue-100 text-blue-700 text-xs rounded-lg">
            {media.exposure}
          </span>
          <span className="px-2 py-1 bg-green-100 text-green-700 text-xs rounded-lg">
            高曝光
          </span>
          <span className="px-2 py-1 bg-purple-100 text-purple-700 text-xs rounded-lg">
            商圈核心
          </span>
        </div>
        
        {/* 价格信息 */}
        <div className="flex items-center justify-between">
          <div>
            <div className="text-2xl font-bold text-gray-900">
              ¥{(media.dealPrice || 0).toLocaleString()}
            </div>
            <div className="text-sm text-gray-500 line-through">
              刊例价: ¥{(media.listPrice || 0).toLocaleString()}
            </div>
          </div>
          
          <div className="flex items-center text-gray-500 text-sm">
            <Eye className="w-4 h-4 mr-1" />
            {media.views || 238} 浏览
          </div>
        </div>
      </div>
    </motion.div>
  )
}